# Copia este archivo a ".env" (mismo directorio) y completa los valores.
# ".env" está en .gitignore y no debe subirse al repositorio.
# Los valores se obtienen en Firebase Console > Project settings > General
# (app web) y en Authentication > Sign-in method > Google (Web client ID).

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_GCM_SENDER_ID=
GOOGLE_WEB_CLIENT_ID=